# ---------------------------------------------------------------------------
# Portfolio environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only variables prefixed with PUBLIC_ are exposed to the browser — by design,
# they must contain nothing secret. There is no server runtime in this project,
# so no private key, OAuth secret or mailbox credential belongs in this file.
# ---------------------------------------------------------------------------

# Canonical origin used for canonical URLs, sitemap.xml and Open Graph tags.
# No trailing slash.
PUBLIC_SITE_URL=https://tebitramson69-netizen.github.io

# Sub-path when hosting under a GitHub Pages *project* site.
# Leave empty for a custom domain or a user/organisation site.
PUBLIC_BASE_PATH=/Student_registration

# ---------------------------------------------------------------------------
# Contact form
#
# The form posts to a third-party form-relay endpoint (Formspree, Basin,
# Web3Forms, a Netlify/Vercel function of your own, ...). The endpoint URL is
# public by nature — it is a write-only intake address, not a credential.
# Leave it EMPTY and the form degrades gracefully to a mailto: link, which is
# the safe default. See README.md ("Contact form").
# ---------------------------------------------------------------------------
PUBLIC_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# Analytics (optional, privacy-conscious, cookieless)
#
# Leave BOTH empty to ship zero analytics and zero third-party requests.
# PUBLIC_ANALYTICS_SRC is the script URL of a self-hosted or cloud Plausible /
# Umami instance; PUBLIC_ANALYTICS_DOMAIN is the site identifier it expects.
# ---------------------------------------------------------------------------
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=
