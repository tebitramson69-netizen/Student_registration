---
/**
 * Inline SVG icons. Inline rather than a sprite or an icon font: there are only
 * a handful, they inherit `currentColor`, and they cost no extra request.
 */
interface Props {
  name: 'github' | 'linkedin' | 'mail' | 'x' | 'link' | 'location' | 'arrow' | 'external' | 'sun' | 'moon' | 'menu' | 'close' | 'download';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;

