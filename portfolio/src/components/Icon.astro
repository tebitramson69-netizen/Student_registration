  mail:
    '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Zm2.1.5 6.9 5.06L18.9 7H5.1Zm13.9 1.2-6.4 4.7a1 1 0 0 1-1.2 0L5 8.2v9.3h14V8.2Z" fill="currentColor"/>',
  location:
    '<path d="M12 2a7 7 0 0 0-7 7c0 5.05 6.24 12.3 6.5 12.6a.66.66 0 0 0 1 0C12.76 21.3 19 14.05 19 9a7 7 0 0 0-7-7Zm0 9.6A2.6 2.6 0 1 1 12 6.4a2.6 2.6 0 0 1 0 5.2Z" fill="currentColor"/>',
  arrow:
    '<path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
  external:
    '<path d="M14 4h6v6M20 4l-8.5 8.5M18 14v4.5A1.5 1.5 0 0 1 16.5 20h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
