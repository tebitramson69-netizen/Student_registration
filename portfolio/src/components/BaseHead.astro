---
import { profile } from '../data/site';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Page-specific OG image path relative to `public/`. */
  image?: string;
  /** 'website' for pages, 'article' for case studies. */
  type?: 'website' | 'article';
  /** Emit Person structured data. Only the home page should. */
  includePersonSchema?: boolean;
}

const {
  title,
  description,
  image = 'og-default.svg',
  type = 'website',
  includePersonSchema = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const ogImage = new URL(url(image), Astro.site);
const fullTitle = title === profile.name ? `${profile.name} — ${profile.role}` : `${title} · ${profile.name}`;

const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  givenName: 'Ramson',
  familyName: 'Tebit',
  url: Astro.site?.toString(),
  email: `mailto:${profile.email}`,
  jobTitle: profile.role,
  description: profile.summary,
  knowsAbout: ['PHP', 'MySQL', 'Laravel', 'JavaScript', 'Web application security', 'Relational database design'],
  address: { '@type': 'PostalAddress', addressLocality: 'Douala', addressCountry: 'CM' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Saint Louis University Institute',
    address: { '@type': 'PostalAddress', addressLocality: 'Douala', addressCountry: 'CM' },
  },
  sameAs: ['https://github.com/tebitramson69-netizen'],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={profile.name} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="generator" content={Astro.generator} />

<!-- Theme colour follows the resolved theme so the mobile browser chrome matches. -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf8" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121110" />

<link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
<link rel="sitemap" href={url('sitemap-index.xml')} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content={profile.name} />

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Fonts: preconnect then a single stylesheet request, swap so text paints immediately. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Inter:wght@400..600&display=swap"
/>

{includePersonSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
)}

{analyticsSrc && (
  <script is:inline defer src={analyticsSrc} data-domain={analyticsDomain}></script>
)}

<!--
  Theme resolution runs before first paint so a dark-mode visitor never sees a
  white flash. `is:inline` keeps it out of the bundle; it must not be deferred.
-->
<script is:inline>
  (function () {
    document.documentElement.classList.remove('no-js');
    try {
      var stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    } catch (e) {
      /* Private mode or blocked storage — fall through to the OS preference. */
    }
  })();
</script>
