---
import { nav, profile, verifiedSocials } from '../data/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page site-footer__inner">
    <div class="site-footer__identity">
      <p class="site-footer__name">{profile.name}</p>
      <p class="site-footer__role">{profile.role}</p>
      <p class="site-footer__location">
        <Icon name="location" size={14} />
        {profile.location}
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <h2 class="site-footer__heading">Pages</h2>
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__nav">
      <h2 class="site-footer__heading">Elsewhere</h2>
      <ul>
        {verifiedSocials.map((social) => (
          <li>
            <a
              href={social.href}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              target={social.href.startsWith('http') ? '_blank' : undefined}
            >
              <Icon name={social.icon} size={15} />
              {social.label}
              {social.href.startsWith('http') && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="page site-footer__base">
    <p>© {year} {profile.name}. All rights reserved.</p>
    <p class="site-footer__colophon">Built with Astro. Written, designed and deployed by hand.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
    padding-block: var(--space-xl) var(--space-m);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40em) {
    .site-footer__inner { grid-template-columns: 1.6fr 1fr 1fr; gap: var(--space-xl); }
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
  }
  .site-footer__role { color: var(--text-muted); font-size: var(--step--1); max-width: 32ch; }
  .site-footer__location {
    display: flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-2xs);
    color: var(--text-subtle);
    font-size: var(--step--1);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: var(--space-2xs);
  }
  .site-footer__nav ul { list-style: none; padding: 0; display: grid; gap: 0.35rem; }
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .site-footer__nav a:hover { color: var(--text); text-decoration: underline; }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border);
    font-size: var(--step--2);
    color: var(--text-subtle);
  }
  .site-footer__colophon { font-family: var(--font-mono); }
</style>
