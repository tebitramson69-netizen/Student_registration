---
import { nav, profile, socials } from '../data/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page">
    <hr class="rule" />

    <!-- The one thing a visitor at the bottom of the page might want: a way to
         start a conversation. So it is the largest thing in the footer. -->
    <div class="foot__cta">
      <p class="meta">Get in touch</p>
      <a class="foot__email sweep" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>

    <div class="foot__cols">
      <div class="foot__identity">
        <p class="foot__name">{profile.name}</p>
        <p class="foot__role">{profile.role}</p>
        <p class="foot__loc meta">
          <Icon name="location" size={13} />
          {profile.location}
        </p>
      </div>

      <nav class="foot__nav" aria-label="Footer">
        <h2 class="meta foot__heading">Pages</h2>
        <ul>
          {nav.map((item) => (
            <li><a class="sweep" href={url(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="foot__nav">
        <h2 class="meta foot__heading">Elsewhere</h2>
        <ul>
          {socials.map((social) => (
            <li>
              <a
                class="sweep"
                href={social.href}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                target={social.href.startsWith('http') ? '_blank' : undefined}
              >
                {social.label}
                {social.href.startsWith('http') && (
                  <span class="visually-hidden">(opens in a new tab)</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="foot__base">
      <p>&copy; {year} {profile.name}</p>
      <p class="foot__colophon">Fraunces &amp; Inter &middot; Built with Astro</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--bg-sunken);
    padding-block: var(--space-xl) var(--space-m);
  }

  /* --- Oversized email --- */
  .foot__cta { padding-block: var(--space-m) var(--space-2xl); }
  .foot__email {
    display: inline-block;
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 3.2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    /* Long addresses must not push the page sideways on a small phone. */
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .foot__email:hover { color: var(--accent-ink); }

  /* --- Columns --- */
  .foot__cols {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 40em) {
    .foot__cols { grid-template-columns: 1.8fr 1fr 1fr; gap: var(--space-xl); }
  }

  .foot__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
  }
  .foot__role { color: var(--text-muted); font-size: var(--step--1); max-width: 30ch; }
  .foot__loc {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-2xs);
  }

  .foot__heading { color: var(--text-subtle); margin-bottom: var(--space-2xs); }
  .foot__nav ul { list-style: none; padding: 0; display: grid; gap: 0.3rem; }
  .foot__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .foot__nav a:hover { color: var(--text); }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-2xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border);
    font-size: var(--step--2);
    color: var(--text-subtle);
  }
  .foot__colophon { font-family: var(--font-mono); }
</style>
