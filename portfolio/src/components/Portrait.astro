---
import { Image } from 'astro:assets';
import { portrait, profile } from '../data/site';
import { uploaded } from '../lib/images';

/**
 * The hero portrait, framed like a plate in a printed piece: a hairline frame,
 * the image, and a caption rule beneath it.
 *
 * With no photograph it renders a monogram plate instead. That fallback is
 * designed rather than apologetic — no dashed "missing image" box, no stock
 * face, and never a generated likeness.
 */
const photo = uploaded(portrait.src);
---
<figure class="plate" data-reveal style="--reveal-delay:120ms">
  <div class="plate__frame">
    {photo ? (
      <Image
        class="plate__image"
        src={photo}
        alt={portrait.alt}
        widths={[320, 480, 640, 960]}
        width={960}
        height={1200}
        sizes="(min-width: 62em) 24rem, min(100vw - 2rem, 22rem)"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div
        class="plate__monogram"
        role="img"
        aria-label={`Monogram standing in for a photograph of ${profile.name}`}
      >
        <span aria-hidden="true">{profile.initials}</span>
      </div>
    )}
  </div>

  <figcaption class="plate__caption">
    <span class="meta">{profile.initials}</span>
    <span class="plate__caption-rule" aria-hidden="true"></span>
    <span class="meta">{profile.location}</span>
  </figcaption>
</figure>

<style>
  .plate {
    margin: 0;
    width: min(100%, 21rem);
    justify-self: center;
  }
  @media (min-width: 62em) {
    .plate { width: 100%; max-width: 23rem; justify-self: end; }
  }

  /* The frame is a hairline with generous padding — the mount around a print,
     not a border around a div. */
  .plate__frame {
    padding: var(--space-2xs);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 2px;
  }

  .plate__image,
  .plate__monogram {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    border-radius: 1px;
    display: block;
  }

  .plate__monogram {
    display: grid;
    place-items: center;
    background:
      radial-gradient(75% 55% at 50% 12%, var(--accent-soft) 0%, transparent 70%),
      var(--bg-sunken);
  }
  .plate__monogram span {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 16vw, 7rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-ink);
    opacity: 0.9;
  }

  .plate__caption {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }
  .plate__caption-rule { flex: 1; height: 1px; background: var(--border); }
</style>
