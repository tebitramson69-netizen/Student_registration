---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { profile, socials, skillGroups } from '../data/site';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const year = new Date().getFullYear();
---
<Base
  title={profile.name}
  description={profile.summary}
  includePersonSchema
>
  <!-- ===================================================================
       HERO - who, what, why keep reading
       =================================================================== -->
  <section class="hero">
    <div class="page">
      <hr class="rule" />

      <!-- Masthead row: the register a printed cover uses. -->
      <div class="hero__masthead">
        <span class="meta">Portfolio &mdash; {year}</span>
        {profile.availability && (
          <span class="meta hero__status">
            <span class="hero__dot" aria-hidden="true"></span>
            {profile.availability}
          </span>
        )}
      </div>

      <div class="hero__grid">
        <div class="hero__text">
          <h1 class="hero__name" data-reveal>{profile.name}</h1>

          <p class="hero__role meta" data-reveal style="--reveal-delay:80ms">
            <span>HND Software Engineering student</span>
            <span>Full-stack developer</span>
            <span>{profile.location}</span>
          </p>

          <p class="hero__tagline" data-reveal style="--reveal-delay:150ms">
            {profile.tagline}
          </p>

          {profile.intro && (
            <p class="hero__body" data-reveal style="--reveal-delay:210ms">
              {profile.intro}
            </p>
          )}

          <div class="hero__actions" data-reveal style="--reveal-delay:270ms">
            <a class="button button--primary" href={url('/projects')}>
              See what I have built
              <Icon name="arrow" size={16} />
            </a>
            <a class="button button--secondary" href={url('/contact')}>Get in touch</a>
          </div>
        </div>

        <Portrait />
      </div>

      <!-- Footer row of the hero: links, ruled off from the composition. -->
      <div class="hero__foot" data-reveal style="--reveal-delay:330ms">
        <hr class="rule" />
        <ul class="hero__socials">
          {socials.map((social) => (
            <li>
              <a
                class="sweep"
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <Icon name={social.icon} size={15} />
                <span>{social.label}</span>
                {social.href.startsWith('http') && (
                  <span class="visually-hidden">(opens in a new tab)</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================================================================
       PROOF — the work, first and prominent
       =================================================================== -->
  <section class="section section--sunken" id="work">
    <div class="page">
      <SectionHeading
        index="01"
        eyebrow="Selected work"
        title="Two systems I designed, built and had to live with"
        lead="Not demos. Both are real applications with a schema, a security model and a list of things still wrong with them — which I have written down."
      />

      <div class="grid-projects">
        {featured.map((project, i) => (
          <ProjectCard project={project} index={i} />
        ))}
      </div>

      <p class="section__more" data-reveal>
        <a href={url('/projects')} class="link-arrow">
          All projects, including the one I built first
          <Icon name="arrow" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- ===================================================================
       CAPABILITY — what I know, honestly scoped
       =================================================================== -->
  <section class="section" id="skills">
    <div class="page">
      <SectionHeading
        index="02"
        eyebrow="Capability"
        title="What I actually work with"
        lead="A short list on purpose. Everything here is something I have used to build one of the projects on this site, or use every working day."
      />

      <dl class="caps">
        {skillGroups.map((group, i) => (
          <div class="caps__row" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <dt class="caps__group">
              <span class="caps__title">{group.title}</span>
              {group.note && <span class="caps__note">{group.note}</span>}
            </dt>
            <dd class="caps__items">
              {group.items.map((item) => (
                <span class="caps__item">
                  <span class="caps__name">{item.name}</span>
                  {item.detail && <span class="caps__detail">{item.detail}</span>}
                </span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ===================================================================
       OPPORTUNITY
       =================================================================== -->
  <section class="section section--sunken">
    <div class="page cta">
      <div class="cta__text" data-reveal>
        <p class="eyebrow">What next</p>
        <h2 class="cta__title">I am looking for the work that makes me better.</h2>
        <p class="cta__body">
          An internship, a junior backend role, an open-source project that needs
          someone patient with a database. If you are hiring or building something,
          I would like to hear about it.
        </p>
      </div>
      <div class="cta__actions" data-reveal style="--reveal-delay:80ms">
        <a class="button button--primary" href={url('/contact')}>
          Start a conversation
          <Icon name="arrow" size={16} />
        </a>
        <a class="button button--secondary" href={url('/about')}>More about me</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===================== Hero ===================== */
  .hero { padding-block: var(--space-m) var(--section-y); }

  /* --- Masthead row --- */
  .hero__masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    padding-top: var(--space-2xs);
  }

  .hero__status { display: inline-flex; align-items: center; gap: 0.55em; color: var(--accent-ink); }
  .hero__dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: currentColor;
    flex: none;
  }

  /* --- Main grid --- */
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
    padding-block: clamp(2rem, 1rem + 5vw, 4rem) clamp(1.5rem, 0.5rem + 3vw, 2.5rem);
  }
  @media (min-width: 62em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  /* The name is the largest thing on the site, and the only place the display
     face is pushed to its tightest tracking. */
  .hero__name {
    font-size: var(--step-5);
    font-weight: 450;
    letter-spacing: -0.032em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero__role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.55em;
    margin-top: var(--space-m);
    color: var(--text-muted);
  }
  /* The separator belongs to the item that follows it, so when the line wraps
     the slash travels down with its word instead of dangling at the end. */
  .hero__role span + span::before {
    content: '/';
    color: var(--accent);
    margin-right: 0.55em;
  }

  .hero__tagline {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    max-width: 26ch;
    /* A hanging rule ties the sentence to the grid rather than floating it. */
    padding-left: var(--space-s);
    border-left: 2px solid var(--accent);
  }

  .hero__body {
    margin-top: var(--space-m);
    color: var(--text-muted);
    max-width: 50ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
  }

  /* --- Foot --- */
  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
  }
  .hero__socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--1);
    color: var(--text-muted);
    min-height: 24px;
  }
  .hero__socials a:hover { color: var(--text); }
  .hero__socials svg { color: var(--text-subtle); }

  /* ===================== Grids ===================== */
  .grid-projects {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }
  @media (min-width: 46em) {
    .grid-projects { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .section__more { margin-top: var(--space-xl); }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--step--1);
    font-weight: 540;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.2em;
    transition: gap var(--duration-base) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .link-arrow:hover { gap: 0.85em; color: var(--accent-ink); border-bottom-color: currentColor; }

  /* ===================== Capabilities table =====================
     A ruled two-column table reads as technical documentation rather than as
     marketing, which is the right register for this content — and it scans far
     faster than four stacked lists. */
  .caps { margin: 0; border-top: 1px solid var(--border); }

  .caps__row {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 46em) {
    .caps__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
      gap: var(--space-l);
      align-items: start;
    }
  }

  .caps__group { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .caps__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
  }
  .caps__note { font-size: var(--step--2); color: var(--text-subtle); font-style: italic; }

  .caps__items {
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }
  @media (min-width: 34em) {
    .caps__items { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s) var(--space-l); }
  }

  .caps__item { display: flex; flex-direction: column; gap: 0.1rem; }
  .caps__name {
    font-size: var(--step--1);
    font-weight: 560;
  }
  .caps__detail { font-size: var(--step--2); color: var(--text-muted); line-height: 1.5; }

  /* ===================== CTA ===================== */
  .cta {
    display: grid;
    gap: var(--space-l);
    align-items: end;
  }
  @media (min-width: 52em) {
    .cta { grid-template-columns: minmax(0, 1.4fr) auto; gap: var(--space-2xl); }
  }
  .cta__title { margin-top: var(--space-2xs); max-width: 20ch; }
  .cta__body { margin-top: var(--space-s); color: var(--text-muted); max-width: 48ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
</style>
