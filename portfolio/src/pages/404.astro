---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---
<Base
  title="Page not found"
  description="That page does not exist. Head back to the homepage or browse the projects."
>
  <section class="section notfound">
    <div class="page">
      <p class="eyebrow">Error 404</p>
      <h1 class="notfound__title">That page is not here.</h1>
      <p class="notfound__body">
        The link may be out of date, or I may have moved something. Either of these
        will get you back on track.
      </p>
      <p class="notfound__actions">
        <a class="button button--primary" href={url('/')}>
          Back to the homepage
          <Icon name="arrow" size={16} />
        </a>
        <a class="button button--secondary" href={url('/projects')}>Browse projects</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .notfound { min-height: 55vh; display: grid; align-content: center; }
  .notfound__title { margin-top: var(--space-2xs); }
  .notfound__body { margin-top: var(--space-s); color: var(--text-muted); max-width: 46ch; }
  .notfound__actions { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-top: var(--space-l); }
</style>
